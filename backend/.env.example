# Приложение
APP_NAME=PlusDesign API
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# База данных (асинхронный драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://plusdesign:plusdesign@localhost:5432/plusdesign
DB_ECHO=false

# CORS: адреса фронтенда (JSON-массив или список через запятую)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Пагинация
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# Авторизация администратора
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Медиа (файлы на диск в этой итерации не загружаются; URL хранятся в БД)
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media

# Уведомления о заявках (необязательно). Если каналы пустые — заявка всё равно сохраняется.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TO=studio@example.com
# SMTP_STARTTLS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Тесты (по умолчанию SQLite в памяти, можно указать отдельную БД Postgres)
# TEST_DATABASE_URL=postgresql+asyncpg://plusdesign:plusdesign@localhost:5432/plusdesign_test
