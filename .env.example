# Скопируйте в .env в корне репозитория.
# Для production: docker compose up --build
# Для локальной разработки: docker compose -f docker-compose.dev.yml up --build

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_USER=plusdesign
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=plusdesign
DATABASE_URL=postgresql+asyncpg://plusdesign:replace-with-strong-db-password@db:5432/plusdesign

JWT_SECRET=replace-with-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Публичный origin сайта (за nginx на :80). Same-origin через прокси /api.
CORS_ORIGINS=["http://localhost"]

# Необязательно: уведомления о новых заявках
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_STARTTLS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
